{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-normalizer.invalid/contracts/worker-protocol.schema.json",
  "title": "Media Normalizer worker NDJSON protocol",
  "oneOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "format": "uuid" },
    "mode": { "enum": ["audio", "video", "both"] },
    "command": {
      "oneOf": [
        { "$ref": "#/$defs/capabilitiesCommand" },
        { "$ref": "#/$defs/scanCommand" },
        { "$ref": "#/$defs/normalizeCommand" },
        { "$ref": "#/$defs/cancelCommand" },
        { "$ref": "#/$defs/processRegistrationAckCommand" },
        { "$ref": "#/$defs/temporaryFileRegistrationAckCommand" }
      ]
    },
    "capabilitiesCommand": {
      "type": "object",
      "required": ["schemaVersion", "id", "cmd"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "cmd": { "const": "capabilities" }
      },
      "additionalProperties": false
    },
    "scanCommand": {
      "type": "object",
      "required": ["schemaVersion", "id", "cmd", "paths", "mode", "recurse"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "cmd": { "const": "scan" },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "mode": { "$ref": "#/$defs/mode" }, "recurse": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "normalizeCommand": {
      "type": "object",
      "required": ["schemaVersion", "id", "cmd", "runId", "inputPaths", "outputDir", "mode", "target", "truePeak", "bitrate", "sampleRate", "collisionPolicy", "speedPercent", "audioOutputFormat", "analyzeOnly", "skipIfNormalized", "normalizationTolerance", "recurse", "preserveHierarchy"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "cmd": { "const": "normalize" },
        "runId": { "$ref": "#/$defs/runId" },
        "inputPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outputDir": { "type": "string", "minLength": 1 }, "mode": { "$ref": "#/$defs/mode" },
        "target": { "type": "number" }, "truePeak": { "type": "number" },
        "bitrate": { "type": "string", "minLength": 1 }, "sampleRate": { "type": "string", "minLength": 1 },
        "collisionPolicy": { "enum": ["rename", "skip", "overwrite"] },
        "speedPercent": { "type": "integer", "minimum": 50, "maximum": 200 },
        "speedPercentByPath": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 50, "maximum": 200 } },
        "audioOutputFormat": { "enum": ["mp3", "m4a", "aac", "flac", "wav", "opus", "ogg"] },
        "analyzeOnly": { "type": "boolean" }, "skipIfNormalized": { "type": "boolean" },
        "normalizationTolerance": { "type": "number", "minimum": 0, "maximum": 10 },
        "recurse": { "type": "boolean" }, "preserveHierarchy": { "type": "boolean" },
        "reportPath": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "cancelCommand": {
      "type": "object",
      "required": ["schemaVersion", "id", "cmd", "runId"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "cmd": { "const": "cancel" }, "runId": { "$ref": "#/$defs/runId" }
      },
      "additionalProperties": false
    },
    "processRegistrationAckCommand": {
      "type": "object",
      "required": ["schemaVersion", "id", "cmd", "runId", "processToken", "processId", "processStartedAtUtc", "accepted"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "cmd": { "const": "process-registration-ack" },
        "runId": { "$ref": "#/$defs/runId" }, "processToken": { "$ref": "#/$defs/id" },
        "processId": { "type": "integer", "minimum": 1 }, "processStartedAtUtc": { "type": "string", "format": "date-time" },
        "accepted": { "type": "boolean" }, "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "temporaryFileRegistrationAckCommand": {
      "type": "object",
      "required": ["schemaVersion", "id", "cmd", "runId", "temporaryPath", "accepted"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "cmd": { "const": "temporary-file-registration-ack" },
        "runId": { "$ref": "#/$defs/runId" }, "temporaryPath": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" }, "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/capabilitiesResult" }, { "$ref": "#/$defs/scanResult" },
        { "$ref": "#/$defs/runStart" }, { "$ref": "#/$defs/fileStart" },
        { "$ref": "#/$defs/progress" }, { "$ref": "#/$defs/log" },
        { "$ref": "#/$defs/fileDone" }, { "$ref": "#/$defs/runDone" },
        { "$ref": "#/$defs/error" }, { "$ref": "#/$defs/processStarting" },
        { "$ref": "#/$defs/processStarted" }, { "$ref": "#/$defs/processExited" },
        { "$ref": "#/$defs/temporaryOutput" }
      ]
    },
    "capabilitiesResult": {
      "type": "object", "required": ["schemaVersion", "type", "id", "modes", "audioInputExtensions", "videoInputExtensions", "audioOutputFormats"],
      "properties": {
        "schemaVersion": { "const": 1 }, "type": { "const": "capabilities-result" }, "id": { "$ref": "#/$defs/id" },
        "modes": { "type": "array", "items": { "$ref": "#/$defs/mode" } },
        "audioInputExtensions": { "type": "array", "items": { "type": "string" } },
        "videoInputExtensions": { "type": "array", "items": { "type": "string" } },
        "audioOutputFormats": { "type": "array", "items": { "enum": ["mp3", "m4a", "aac", "flac", "wav", "opus", "ogg"] } }
      }, "additionalProperties": false
    },
    "scanResult": {
      "type": "object", "required": ["schemaVersion", "type", "id", "files"],
      "properties": {
        "schemaVersion": { "const": 1 }, "type": { "const": "scan-result" }, "id": { "$ref": "#/$defs/id" },
        "files": { "type": "array", "items": { "type": "object", "required": ["path", "extension", "audioEligible", "videoEligible"], "properties": {
          "path": { "type": "string", "minLength": 1 }, "extension": { "type": "string" },
          "audioEligible": { "type": "boolean" }, "videoEligible": { "type": "boolean" }
        }, "additionalProperties": false } }
      }, "additionalProperties": false
    },
    "runStart": { "type": "object", "required": ["schemaVersion", "type", "runId", "mode"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "run-start" }, "runId": { "$ref": "#/$defs/runId" }, "mode": { "$ref": "#/$defs/mode" } }, "additionalProperties": false },
    "fileStart": { "type": "object", "required": ["schemaVersion", "type", "runId", "fileIndex", "total", "inputPath"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "file-start" }, "runId": { "$ref": "#/$defs/runId" }, "fileIndex": { "type": "integer", "minimum": 1 }, "total": { "type": "integer", "minimum": 1 }, "inputPath": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "progress": { "type": "object", "required": ["schemaVersion", "type", "runId", "percent", "phase", "eta", "inputPath"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "progress" }, "runId": { "$ref": "#/$defs/runId" }, "percent": { "type": "number", "minimum": 0, "maximum": 100 }, "phase": { "type": "string", "minLength": 1 }, "eta": { "type": ["number", "null"], "minimum": 0 }, "inputPath": { "type": ["string", "null"] } }, "additionalProperties": false },
    "log": { "type": "object", "required": ["schemaVersion", "type", "runId", "level", "message"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "log" }, "runId": { "$ref": "#/$defs/runId" }, "level": { "enum": ["debug", "info", "warning", "error"] }, "message": { "type": "string" } }, "additionalProperties": false },
    "fileDone": { "type": "object", "required": ["schemaVersion", "type", "runId", "inputPath", "outputPath", "status", "measurements", "message"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "file-done" }, "runId": { "$ref": "#/$defs/runId" }, "inputPath": { "type": "string", "minLength": 1 }, "outputPath": { "type": ["string", "null"] }, "status": { "enum": ["normalized", "analyzed", "skipped", "failed", "cancelled"] }, "measurements": { "type": ["object", "null"] }, "message": { "type": ["string", "null"] } }, "additionalProperties": false },
    "runDone": { "type": "object", "required": ["schemaVersion", "type", "runId", "success", "analyzed", "fail", "skipped", "cancelled", "reportPath", "reportSucceeded"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "run-done" }, "runId": { "$ref": "#/$defs/runId" }, "success": { "type": "integer", "minimum": 0 }, "analyzed": { "type": "integer", "minimum": 0 }, "fail": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 }, "cancelled": { "type": "integer", "minimum": 0 }, "reportPath": { "type": ["string", "null"] }, "reportSucceeded": { "type": ["boolean", "null"] } }, "additionalProperties": false },
    "error": { "type": "object", "required": ["schemaVersion", "type", "code", "message"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "error" }, "runId": { "$ref": "#/$defs/runId" }, "inputPath": { "type": "string" }, "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "processStarting": { "type": "object", "required": ["schemaVersion", "type", "runId", "processToken", "executablePath", "arguments", "parentProcessId", "parentStartedAtUtc"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "process-starting" }, "runId": { "$ref": "#/$defs/runId" }, "processToken": { "$ref": "#/$defs/id" }, "executablePath": { "type": "string", "minLength": 1 }, "arguments": { "type": "array", "items": { "type": "string" } }, "parentProcessId": { "type": "integer", "minimum": 1 }, "parentStartedAtUtc": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
    "processStarted": { "type": "object", "required": ["schemaVersion", "type", "runId", "processToken", "processId", "processStartedAtUtc", "executablePath", "parentProcessId", "parentStartedAtUtc"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "process-started" }, "runId": { "$ref": "#/$defs/runId" }, "processToken": { "$ref": "#/$defs/id" }, "processId": { "type": "integer", "minimum": 1 }, "processStartedAtUtc": { "type": "string", "format": "date-time" }, "executablePath": { "type": "string", "minLength": 1 }, "parentProcessId": { "type": "integer", "minimum": 1 }, "parentStartedAtUtc": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
    "processExited": { "type": "object", "required": ["schemaVersion", "type", "runId", "processToken", "processId", "processStartedAtUtc", "exitCode"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "process-exited" }, "runId": { "$ref": "#/$defs/runId" }, "processToken": { "$ref": "#/$defs/id" }, "processId": { "type": "integer", "minimum": 1 }, "processStartedAtUtc": { "type": "string", "format": "date-time" }, "exitCode": { "type": "integer" } }, "additionalProperties": false },
    "temporaryOutput": { "type": "object", "required": ["schemaVersion", "type", "runId", "inputPath", "temporaryPath", "finalPath", "role"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "temporary-output" }, "runId": { "$ref": "#/$defs/runId" }, "inputPath": { "type": "string", "minLength": 1 }, "temporaryPath": { "type": "string", "minLength": 1 }, "finalPath": { "type": "string", "minLength": 1 }, "role": { "enum": ["primary", "speed"] } }, "additionalProperties": false }
  }
}
